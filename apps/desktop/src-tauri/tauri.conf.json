{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FixPlease",
  "version": "0.2.6",
  "identifier": "top.mita.fixplease",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FixPlease",
        "width": 900,
        "height": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "certs/fixplease-ca.cer": "certs/fixplease-ca.cer",
      "config/default-server-url.txt": "config/default-server-url.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MjkzMTQ2MzcwQzhBRUUKUldUdWlndzNSakVwK1ROU0x0aVF4dUZDM2ZCU0NwanpQclNKT0xPV3cyNW9UUyt0SnJlOWpiNHQK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "dangerousAcceptInvalidCerts": true,
      "dangerousAcceptInvalidHostnames": true
    }
  }
}

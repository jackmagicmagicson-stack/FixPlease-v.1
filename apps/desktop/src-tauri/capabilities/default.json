{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:tray:default",
    "notification:default",
    "websocket:default",
    "updater:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }],
      "deny": [
        "$EXE/**",
        "$RESOURCE/**",
        "$RUNTIME/**",
        "**/Windows/**",
        "**/WINDOWS/**",
        "**/Program Files/**",
        "**/Program Files (x86)/**",
        "**/ProgramData/**",
        "**/System Volume Information/**",
        "**/$Recycle.Bin/**",
        "**/Recovery/**",
        "**/Boot/**",
        "**/etc/**",
        "**/sys/**",
        "**/proc/**",
        "**/dev/**",
        "**/bin/**",
        "**/sbin/**",
        "**/usr/**",
        "**/System/**",
        "**/Library/Apple/**"
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "https://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "https://localhost:*" },
        { "url": "http://192.168.*:*" },
        { "url": "https://192.168.*:*" },
        { "url": "http://10.*:*" },
        { "url": "https://10.*:*" },
        { "url": "http://172.*:*" },
        { "url": "https://172.*:*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
